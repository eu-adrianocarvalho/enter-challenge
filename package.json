{
  "name": "xp-monthly-letter",
  "private": true,
  "description": "XP monthly client letter, run end to end as a Rivet graph (monthly_letter).",
  "scripts": {
    "build": "node rivet/build.mjs",
    "letter": "node --env-file=.env node_modules/@ironclad/rivet-cli/bin/cli.js run rivet/xp_monthly_letter.rivet-project monthly_letter",
    "test": "node --test \"rivet/tests/*.test.mjs\""
  },
  "devDependencies": {
    "@ironclad/rivet-cli": "1.25.0"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "yaml": "^2.9.1"
  }
}
